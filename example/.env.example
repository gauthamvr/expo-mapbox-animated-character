# Copy this file to `.env` and paste your own PUBLIC Mapbox token (starts with `pk.`).
# Get one free at https://account.mapbox.com/access-tokens/
#
# This is the runtime token the map uses to fetch tiles. It is NOT the secret
# downloads token (`sk.…`) — you no longer need one of those to build the SDK.
EXPO_PUBLIC_MAPBOX_TOKEN=pk.replace_me
